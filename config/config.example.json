{
  "debug": false,
  "registerToolOverrides": {
    "read": true,
    "grep": true,
    "find": true,
    "ls": true,
    "bash": true,
    "edit": true,
    "write": true
  },
  "customToolOverrides": {
    "ide_find_symbol": {
      "enabled": false,
      "kind": "generic",
      "outputMode": "summary",
      "preserveCallRenderer": true
    },
    "custom_mcp_gateway": {
      "enabled": false,
      "kind": "mcp",
      "outputMode": "summary"
    }
  },
  "enableNativeUserMessageBox": true,
  "enableShikiCodeBlocks": true,
  "formatCodeBlocks": true,
  "shikiCodeBlockTheme": "github-dark",
  "readOutputMode": "hidden",
  "searchOutputMode": "hidden",
  "mcpOutputMode": "hidden",
  "codemodeOutputMode": "calls",
  "codemodeShowFileDiffs": true,
  "previewLines": 8,
  "expandedPreviewMaxLines": 4000,
  "bashOutputMode": "opencode",
  "bashCollapsedLines": 10,
  "bashCommandMaxChars": 0,
  "bashIntentMode": "off",
  "bashIntentShowCommand": false,
  "diffViewMode": "auto",
  "diffIndicatorMode": "bars",
  "diffSplitMinWidth": 120,
  "diffCollapsedLines": 24,
  "diffWordWrap": true,
  "diffSyntaxHighlighting": "shiki",
  "diffAddedBg": "#14351f",
  "diffRemovedBg": "#3a1d20",
  "diffAddedEmphasisBg": "#1d5230",
  "diffRemovedEmphasisBg": "#57262b",
  "allowExternalDiffPreviews": false,
  "showTruncationHints": false,
  "showRtkCompactionHints": false
}
