{
  "name": "pi-ui-enhancement",
  "version": "2026.10.24-r3",
  "description": "Compact tool call rendering, diff visualization, Shiki code blocks, codemode diffs, and output truncation for the Pi coding agent. Successor to pi-tool-display.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tool-display-api-consumer": {
      "types": "./tool-display-api-consumer.d.ts",
      "default": "./tool-display-api-consumer.js"
    }
  },
  "files": [
    "index.ts",
    "tool-display-api-consumer.js",
    "tool-display-api-consumer.d.ts",
    "src",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "docs/FORK-NOTES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run test",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-tui",
    "coding-agent",
    "tui",
    "tool-rendering",
    "tool-output",
    "diff-visualization",
    "output-truncation",
    "hide",
    "collapse",
    "truncate",
    "compact",
    "diff",
    "output-mode"
  ],
  "author": "MasuRii, contributors (fork: ahati)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahati/pi-ui-enhancement.git"
  },
  "bugs": {
    "url": "https://github.com/ahati/pi-ui-enhancement/issues"
  },
  "homepage": "https://github.com/ahati/pi-ui-enhancement#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "file-type": ">=21.3.1",
    "protobufjs": "7.6.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "shiki": "^4.5.0"
  }
}
